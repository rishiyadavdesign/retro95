{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/desktop", "destination": "/desktop/index.html" },
    { "source": "/desktop/", "destination": "/desktop/index.html" },
    { "source": "/landing", "destination": "/landing/index.html" },
    { "source": "/landing/", "destination": "/landing/index.html" },
    { "source": "/portfolio", "destination": "/portfolio/index.html" },
    { "source": "/portfolio/", "destination": "/portfolio/index.html" },
    { "source": "/portfolio/fluido", "destination": "/portfolio/fluido/index.html" },
    { "source": "/portfolio/fluido/", "destination": "/portfolio/fluido/index.html" },
    { "source": "/portfolio/foodspot", "destination": "/portfolio/foodspot/index.html" },
    { "source": "/portfolio/foodspot/", "destination": "/portfolio/foodspot/index.html" },
    { "source": "/portfolio/papernote", "destination": "/portfolio/papernote/index.html" },
    { "source": "/portfolio/papernote/", "destination": "/portfolio/papernote/index.html" },
    { "source": "/portfolio/zeto", "destination": "/portfolio/zeto/index.html" },
    { "source": "/portfolio/zeto/", "destination": "/portfolio/zeto/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/contact/", "destination": "/contact/index.html" },
    { "source": "/music", "destination": "/music/index.html" },
    { "source": "/music/", "destination": "/music/index.html" },
    { "source": "/bin", "destination": "/bin/index.html" },
    { "source": "/bin/", "destination": "/bin/index.html" },
    { "source": "/404", "destination": "/404/index.html" },
    { "source": "/404/", "destination": "/404/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
